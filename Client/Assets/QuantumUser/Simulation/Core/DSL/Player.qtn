component PlayerLink
{
	player_ref Player;
}

component PlayerSpawner
{
    player_ref PlayerRef;
    CharacterTeam PlayerTeam;
}

component PlayerStatusComponent
{
    asset_ref<StatusData> StatusData;
    asset_ref<HitReactionData> HitReactionData;
	
	KnockbackStatusEffect KnockbackStatusEffect;
}

component PlayerMovementComponent
{
    asset_ref<PlayerMovementData> CharacterMovementData;

	[ExcludeFromPrototype] bool IsFacingRight;
	[ExcludeFromPrototype] bool HasAirJump;
}