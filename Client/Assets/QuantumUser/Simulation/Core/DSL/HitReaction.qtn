// 击退模式枚举
enum KnockbackMode
{
    Physics = 0,      // 物理模式：水平衰减 + 重力
    CustomCurve = 1,  // 曲线模式：完全自定义
    LinearDecay = 2   // 线性衰减：原有模式
}

// 受击类型枚举
enum HitType
{
    None,
    Light,
    Heavy,
    Launch
}

// 击退配置数据（高性能 struct）
struct KnockbackConfig
{
    // 模式选择
    KnockbackMode Mode;
    
    // Physics 模式参数
    FP HorizontalDecayRate;  // 水平速度衰减率
    bool UseGravity;          // 是否使用重力
    
    // Curve 模式参数
    FP CurveDuration;         // 曲线持续时间
    
    // Linear 模式参数
    FP LinearDecayRate;       // 线性衰减率
    FP MinThreshold;          // 最小速度阈值
}

// 受击反馈组件
component HitReactionComponent
{
    // 配置引用
    asset_ref<HitReactionData> HitReactionData;
    
    // 硬直状态
    bool IsHitstunned;
    FrameTimer HitstunTimer;
    
    // 击退状态
    bool IsKnockedBack;
    FPVector2 KnockbackVelocity;
    FP KnockbackDecay;
    
    // 曲线击飞支持（新增字段）
    FPVector2 InitialKnockbackVelocity;
    FP KnockbackStartTime;
    FP KnockbackDuration;
    KnockbackMode CurrentMode;
}
