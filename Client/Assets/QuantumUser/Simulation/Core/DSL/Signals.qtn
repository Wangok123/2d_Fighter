// Custom signals for movement and ability systems
// These signals allow us to use SystemSignalsOnly pattern for better performance

// Signal fired when player input is processed and needs to be applied to movement
signal OnMovementInput(EntityRef Entity, SimpleInput2D Input);

// Signal fired when an ability should be executed
signal OnAbilityExecute(EntityRef Entity, AbilityId AbilityId, SimpleInput2D Input);

// Signal fired when attack ability is triggered
signal OnAttackAbilityTrigger(EntityRef Entity, Int32 AttackType);

// Signal fired when defense ability is triggered  
signal OnDefenseAbilityTrigger(EntityRef Entity, Int32 DefenseType);

// Signal fired when special ability is triggered
signal OnSpecialAbilityTrigger(EntityRef Entity, Int32 SpecialType);

// Signal fired when movement unlocks need to be checked
signal OnMovementUnlockCheck(EntityRef Entity);
