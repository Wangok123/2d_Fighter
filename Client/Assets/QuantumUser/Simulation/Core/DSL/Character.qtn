component CharacterStatusComponent
{
    asset_ref<HitReactionData> HitReactionData;
	
	Boolean IsSuperArmored;
	
	KnockbackStatusEffect KnockbackStatusEffect;
}

component MovementComponent
{
    asset_ref<MovementData> MovementData;

	[ExcludeFromPrototype] bool IsFacingRight;
	[ExcludeFromPrototype] bool HasAirJump;
}

component AttackComponent
{
	[ExcludeFromPrototype] Int32 ComboCounter;
	[ExcludeFromPrototype] FrameTimer ComboResetTimer;
	[ExcludeFromPrototype] FrameTimer AttackCooldown;
	[ExcludeFromPrototype] bool IsAttacking;
	[ExcludeFromPrototype] FP HeavyChargeTime;
	[ExcludeFromPrototype] bool IsChargingHeavy;
	
	[ExcludeFromPrototype] FrameTimer ChargeTimer;
    [ExcludeFromPrototype] FrameTimer ComboWindowTimer;
    
    [ExcludeFromPrototype] FPVector2 KnockbackDirection;
    
    [ExcludeFromPrototype]
    QBoolean HasStartedHitboxWindow;
    
    [ExcludeFromPrototype]
    list<EntityRef> HitEntitiesThisAttack;
}

// Events
event OnPlayerHit
{
    entity_ref Entity;
    entity_ref Attacker;
    FP Damage;
    FPVector2 HitDirection;
    HitType HitType;
    bool IsCounterHit;
}

event OnPlayerDied
{
    entity_ref Entity;
    entity_ref Killer;
}

event OnPlayerRespawn
{
    entity_ref Entity;
    FPVector2 Position;
}

event OnPlayerKnockedBack
{
    entity_ref Entity;
    FPVector2 Direction;
    FP Force;
}

event OnSuperArmorTriggered
{
    entity_ref Entity;
    FP RemainingArmor;
}


event LevelUp
{
	EntityRef Entity;
	Int32 NewLevel;
	Int32 OldLevel;
}

event AttackPerformed
{
	EntityRef Attacker;
	Boolean IsHeavyAttack;
	Int32 ComboCount;
	FP Damage;
	FP ChargeLevel;
}

event SpecialMovePerformed
{
	EntityRef Attacker;
	Int32 MoveId;
	FP Damage;
}

event AbilityActivated
{
    EntityRef Entity;
    AbilityType AbilityType;
}

event AbilityCancelled
{
    EntityRef Entity;
    AbilityType AbilityType;
}

event AbilityEnded
{
    EntityRef Entity;
    AbilityType AbilityType;
}

// 连击事件
event ComboAttackStarted
{
    EntityRef Entity;
    Int32 Step;
    Int32 MaxSteps;
}

// 蓄力攻击事件
event ChargeAttackReleased
{
    EntityRef Entity;
    FP ChargeTime;
    Boolean IsFullyCharged;
}

// 蓄力开始事件
event ChargingStarted
{
    EntityRef Entity;
    FP MaxChargeTime;
}

// 蓄力取消事件
event ChargingCancelled
{
    EntityRef Entity;
}

event AttackHitboxActivated
{
    entity_ref Entity;
    Int32 ComboStep;
}

event PlungeAttackStarted
{
    EntityRef Entity;
}

event PlungeAttackLanded
{
    EntityRef Entity;
}


