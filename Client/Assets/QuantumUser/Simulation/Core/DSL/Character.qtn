enum CharacterTeam
{
    None, Blue, Red, Neutral
}

component CharacterStatusComponent
{
    asset_ref<StatusData> StatusData;
    asset_ref<PlayerMovementData> PlayerMovementData;
    
	FP CurrentHealth;
	Boolean IsDead;
	Boolean IsIncapacitated;
	
	FrameTimer DisconnectedTimer;
}

component MovementComponent
{
	[ExcludeFromPrototype] bool IsFacingRight;
	[ExcludeFromPrototype] bool HasAirJump;
}

component CharacterLevelComponent
{
	Int32 CurrentLevel;
}

component AttackComponent
{
	// Single source of character configuration - ModularCharacterConfig replaces legacy AttackConfig
	[ExcludeFromPrototype] Int32 ComboCounter;
	[ExcludeFromPrototype] FrameTimer ComboResetTimer;
	[ExcludeFromPrototype] FrameTimer AttackCooldown;
	[ExcludeFromPrototype] bool IsAttacking;
	[ExcludeFromPrototype] FP HeavyChargeTime;
	[ExcludeFromPrototype] bool IsChargingHeavy;
	
	[ExcludeFromPrototype] FrameTimer ChargeTimer;
    [ExcludeFromPrototype] FrameTimer ComboWindowTimer;
}

component CommandInputData
{
	[ExcludeFromPrototype] Int32 InputBufferSize;
	[ExcludeFromPrototype] array<Int32>[8] InputBuffer;
	[ExcludeFromPrototype] Int32 InputBufferIndex;
	[ExcludeFromPrototype] FrameTimer InputExpiryTimer;
}

// Signals
signal OnKnockbackApplied(EntityRef target, FP duration, FPVector2 knockbackVelocity);
signal OnStunApplied(EntityRef target, FP duration);
signal OnHitstunApplied(EntityRef target, FP duration);
signal OnDamageTaken(EntityRef target, EntityRef attacker, FP damage, HitType hitType);
signal OnEntityDied(EntityRef target, EntityRef killer);
signal OnEntityRespawned(EntityRef entity);
signal OnSuperArmorActivated(EntityRef entity);
signal OnSuperArmorBroken(EntityRef entity);

// Events
event OnPlayerHit
{
    entity_ref Entity;
    entity_ref Attacker;
    FP Damage;
    FPVector2 HitDirection;
    HitType HitType;
    bool IsCounterHit;
}

event OnPlayerDied
{
    entity_ref Entity;
    entity_ref Killer;
}

event OnPlayerRespawn
{
    entity_ref Entity;
    FPVector2 Position;
}

event OnPlayerKnockedBack
{
    entity_ref Entity;
    FPVector2 Direction;
    FP Force;
}

event OnSuperArmorTriggered
{
    entity_ref Entity;
    FP RemainingArmor;
}


event LevelUp
{
	EntityRef Entity;
	Int32 NewLevel;
	Int32 OldLevel;
}

event AttackPerformed
{
	EntityRef Attacker;
	Boolean IsHeavyAttack;
	Int32 ComboCount;
	FP Damage;
	FP ChargeLevel;
}

event SpecialMovePerformed
{
	EntityRef Attacker;
	Int32 MoveId;
	FP Damage;
}

event AbilityActivated
{
    EntityRef Entity;
    AbilityType AbilityType;
}

event AbilityCancelled
{
    EntityRef Entity;
    AbilityType AbilityType;
}

event AbilityEnded
{
    EntityRef Entity;
    AbilityType AbilityType;
}

// 连击事件
event ComboAttackStarted
{
    EntityRef Entity;
    Int32 Step;
    Int32 MaxSteps;
}

// 蓄力攻击事件
event ChargeAttackReleased
{
    EntityRef Entity;
    FP ChargeTime;
    Boolean IsFullyCharged;
}

// 蓄力开始事件
event ChargingStarted
{
    EntityRef Entity;
    FP MaxChargeTime;
}

// 满蓄力事件
event ChargeMaxReached
{
    EntityRef Entity;
}

event AttackHitboxActivated
{
    entity_ref Entity;
    Int32 ComboStep;
}



