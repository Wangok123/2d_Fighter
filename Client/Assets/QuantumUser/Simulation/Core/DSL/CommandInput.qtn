enum CommandInput
{
    None = 0,
    Down = 1,
    DownRight = 2,
    Right = 3,
    UpRight = 4,
    Up = 5,
    UpLeft = 6,
    Left = 7,
    DownLeft = 8,
    LP = 9,
    HP = 10,
    Dash = 11,
    Jump = 12
}

struct SpecialMove
{
    array<Int32>[8] InputSequence;
    Int32 SequenceLength;
    Int32 MoveId;
    FP Damage;
}

component CommandInputComponent
{
	[ExcludeFromPrototype] Int32 InputBufferSize;
	[ExcludeFromPrototype] array<Int32>[8] InputBuffer;
	[ExcludeFromPrototype] Int32 InputBufferIndex;
	[ExcludeFromPrototype] FrameTimer InputExpiryTimer;
}

signal OnClearInputBuffer(entity_ref playerEntityRef);

event CommandAttackExecuted{
    entity_ref PlayerEntityRef;
    Int32 MoveId;
}