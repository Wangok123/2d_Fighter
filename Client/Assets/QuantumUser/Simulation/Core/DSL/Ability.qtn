enum AbilityType
{
    Block, Jump, Dash, Attack
}

// Movement ability identifiers
enum MovementAbilityId
{
    None = 0,
    DoubleJump = 1,
    Dash = 2,
    WallJump = 3,
    AirDash = 4,
    Glide = 5
}

// Attack ability identifiers
enum AttackAbilityId
{
    None = 0,
    LightAttack = 1,
    HeavyAttack = 2,
    RangedAttack = 3,
    AreaAttack = 4
}

// Defense ability identifiers
enum DefenseAbilityId
{
    None = 0,
    Block = 1,
    Parry = 2,
    Dodge = 3,
    Shield = 4
}

// Special ability identifiers
enum SpecialAbilityId
{
    None = 0,
    Ultimate = 1,
    Transformation = 2,
    Summon = 3
}

// Combined ability ID enum for general use
enum AbilityId
{
    None = 0,
    
    // Movement abilities (1-99)
    MovementDoubleJump = 1,
    MovementDash = 2,
    MovementWallJump = 3,
    MovementAirDash = 4,
    MovementGlide = 5,
    
    // Attack abilities (100-199)
    AttackLight = 100,
    AttackHeavy = 101,
    AttackRanged = 102,
    AttackArea = 103,
    
    // Defense abilities (200-299)
    DefenseBlock = 200,
    DefenseParry = 201,
    DefenseDodge = 202,
    DefenseShield = 203,
    
    // Special abilities (300-399)
    SpecialUltimate = 300,
    SpecialTransformation = 301,
    SpecialSummon = 302
}
