// Ability identifier enum for all ability types
// Organized by value ranges for different categories
enum AbilityType
{
    None = 0,
    
    // Movement abilities (1-99)
    MovementDoubleJump = 1,
    MovementDash = 2,
    MovementWallJump = 3,
    MovementWallSlide = 4,
    MovementAirDash = 5,
    MovementGlide = 6,
    Movement = 7,
    MovementJump = 8,
    
    // Attack abilities (100-199)
    AttackLight = 100,
    AttackHeavy = 101,
    AttackRanged = 102,
    AttackArea = 103,
    
    // Defense abilities (200-299)
    DefenseBlock = 200,
    DefenseParry = 201,
    DefenseDodge = 202,
    DefenseShield = 203,
    
    // Special abilities (300-399)
    SpecialUltimate = 300,
    SpecialTransformation = 301,
    SpecialSummon = 302
}

component AbilityEnable
{
     bool MovementDoubleJumpEnabled;
     bool MovementDashEnabled;
     bool MovementWallJumpEnabled;
     bool MovementWallSlideEnabled;
     bool MovementAirDashEnabled;
     bool MovementGlideEnabled;
     bool MovementEnabled;
     bool MovementJumpEnabled;
     
     bool AttackLightEnabled;
     bool AttackHeavyEnabled;
     bool AttackRangedEnabled;
     bool AttackAreaEnabled;
     
     bool DefenseBlockEnabled;
     bool DefenseParryEnabled;
     bool DefenseDodgeEnabled;
     bool DefenseShieldEnabled;
     
     bool SpecialUltimateEnabled;
     bool SpecialTransformationEnabled;
     bool SpecialSummonEnabled;
}

enum AttackKnockbackType
{
    AwayFromAttacker,
    AttackerFacingDirection,
    Up,
    Fixed
}

enum CommandAttackExecutionType
{
    Hitbox,
    Projectile,
    SkillField,
}

component AbilityInventory
{
    [ExcludeFromPrototype] ActiveAbilityInfo ActiveAbilityInfo;
      
    [FreeOnComponentRemoved]
    dictionary<AbilityType, Ability> AbilitiesDic;
}

// 指令攻击运行时数据
component CommandAttackRuntimeComponent
{
    [ExcludeFromPrototype]
    int MatchedSequenceIndex;
    
    [ExcludeFromPrototype]
    QBoolean HasStartedHitboxWindow;
    
    [ExcludeFromPrototype]
    list<EntityRef> HitEntitiesThisAttack;
}

component ComboAttackRuntimeComponent
{
    [ExcludeFromPrototype]
    Int32 CurrentComboStep;
    
    [ExcludeFromPrototype]
    FP CurrentHitboxActiveTime;
    
    [ExcludeFromPrototype]
    FP CurrentHitboxActiveDuration;
    
    [ExcludeFromPrototype]
    FP CurrentKnockbackForce;
    
    [ExcludeFromPrototype]
    FP CurrentHitstunDuration;
    
    [ExcludeFromPrototype]
    FPVector2 CurrentKnockbackDirection;
}

struct AttackAbilityCache
{
    FP Duration;
    FP HitboxActiveTime;
    FP HitboxActiveDuration;
    FP KnockbackForce;
    FP HitstunDuration;
}

struct ActiveAbilityInfo
{
    [ExcludeFromPrototype] AbilityType ActiveAbilityType;

    [ExcludeFromPrototype] FPVector2 CastDirection;
    [ExcludeFromPrototype] FPQuaternion CastRotation;
    [ExcludeFromPrototype] FPVector2 CastVelocity;
}

struct Ability
{
    FP RuntimeDuration;

    [ExcludeFromPrototype] CountdownTimer InputBufferTimer;
    [ExcludeFromPrototype] CountdownTimer DelayTimer;
    [ExcludeFromPrototype] CountdownTimer DurationTimer;
    [ExcludeFromPrototype] CountdownTimer CooldownTimer;

    asset_ref<AbilityData> AbilityData;
    
     // 扩展字段用于复杂输入
    FrameTimer ChargeTimer;
    Int32 UsageCount;
    Int32 ComboStep;
}

struct ComboRuntimeConfig
{
    FP Duration;
    FP HitboxActiveTime;
    FP HitboxActiveDuration;
    FP KnockbackForce;
    FP KnockbackDirectionX;
    FP KnockbackDirectionY;
    FP HitstunDuration;
    HitType HitType;
    int ComboStepIndex;
}

signal CheckAbilityEnabled(AbilityType abilityId);
signal OnCooldownsReset(entity_ref playerEntityRef);
signal OnActiveAbilityStopped(entity_ref playerEntityRef);

signal OnAttackHitboxActivate(entity_ref attacker);
signal OnAttackExecute(entity_ref attacker);

signal OnCommandAttackActivated(entity_ref attacker, Int32 sequenceIndex);
signal OnCommandAttackHitboxActivate(entity_ref attacker, Int32 sequenceIndex);
signal OnCommandAttackExecute(entity_ref attacker, Int32 sequenceIndex);